{
  "name": "healthconnection",
  "version": "1.0.0",
  "description": "health Connection es un sistema de informacion que ayudara a gestionar clinicas privadas con la asignacion de citas, examenes y demas tareas de este rubro",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon Server/index.js",
    "start": "node Server/index.js",
    "postinstall": "npx sequelize-cli db:migrate",
    "client": "vite Client/",
    "test": "jest",
    "lint": "eslint Server/**",
    "lint:fix": "eslint Server/** --fix",
    "dev:all": "concurrently \"npm run dev\" \"npm run client\"",
    "migrations:generate": "sequelize-cli migration:generate --name",
    "migrations:run": "sequelize-cli db:migrate",
    "migrations:revert": "sequelize-cli db:migrate:undo --name",
    "migrations:delete": "sequelize-cli db:migrate:undo:all",
    "seeders:generate": "sequelize-cli seed:generate --name",
    "seeders:run": "sequelize-cli db:seed:all",
    "seeders:run:name": "sequelize-cli db:seed --name",
    "seeders:revert": "sequelize-cli db:seed:undo",
    "seeders:delete": "sequelize-cli db:seed:undo:all",
    "setup:db": "npm run migrations:run && npm run seeders:run",
    "reset:db": "npm run seeders:delete && npm run migrations:delete"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@faker-js/faker": "^9.8.0",
    "@hapi/boom": "^10.0.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^3.1.2",
    "luxon": "^3.6.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.0",
    "nodemon": "^3.1.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.14.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/jest": "^29.5.14",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.1.1"
  }
}
